{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Run python_test (file)",
      "type": "python",
      "request": "launch",
      "program": "${workspaceFolder}/mi_proyecto/src/mi_proyecto/python_test.py",
      "console": "integratedTerminal",
      "justMyCode": true,
      "env": {
        "PYTHONPATH": "${workspaceFolder}/mi_proyecto/src"
      }
    },
    {
      "name": "Run python_test (module)",
      "type": "python",
      "request": "launch",
      "module": "mi_proyecto.python_test",
      "cwd": "${workspaceFolder}/mi_proyecto",
      "console": "integratedTerminal",
      "justMyCode": true,
      "env": {
        "PYTHONPATH": "${workspaceFolder}/mi_proyecto/src"
      }
    },
    {
      "name": "Run python_test (top-level compatibility)",
      "type": "python",
      "request": "launch",
      "module": "python_test",
      "cwd": "${workspaceFolder}/mi_proyecto",
      "console": "integratedTerminal",
      "justMyCode": true,
      "env": {
        "PYTHONPATH": "${workspaceFolder}/mi_proyecto/src/mi_proyecto"
      }
    },
    {
      "name": "Run estadistica",
      "type": "python",
      "request": "launch",
      "module": "mi_proyecto.estadistica",
      "cwd": "${workspaceFolder}/mi_proyecto",
      "console": "integratedTerminal",
      "justMyCode": true,
      "env": {
        "PYTHONPATH": "${workspaceFolder}/mi_proyecto/src"
      }
    },
    {
      "name": "Run main",
      "type": "python",
      "request": "launch",
      "module": "mi_proyecto.main",
      "cwd": "${workspaceFolder}/mi_proyecto",
      "console": "integratedTerminal",
      "justMyCode": true,
      "env": {
        "PYTHONPATH": "${workspaceFolder}/mi_proyecto/src"
      }
    }
  ]
}
